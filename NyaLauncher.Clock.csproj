<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NyaLauncher.Clock</AssemblyName>
    <RootNamespace>NyaLauncher.Clock</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launcher supplies this API v1 assembly at runtime. -->
    <Reference Include="NyaLauncher.Plugin.Abstractions">
      <HintPath>sdk\NyaLauncher.Plugin.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
